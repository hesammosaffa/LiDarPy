# ===== PLC connection (LCS sends commands here) =====
PLC_IP_ADDRESS=192.168.109.1
PLC_COMMAND_PORT=5000

# ===== Launcher feedback (FCS receives status here) =====
FEEDBACK_LISTEN_IP=
FEEDBACK_LISTEN_PORT=5005

# ===== Command sending =====
COMMAND_SEND_INTERVAL_S=0.002
FIRE_PULSE_DURATION_S=0.3
FEEDBACK_REFRESH_MS=100

# ===== Manual jog step sizes (same units as the set-point) =====
JOG_STEP_0_1=0.1
JOG_STEP_0_5=0.5
JOG_STEP_1=1.0
JOG_STEP_10=10.0
JOG_STEP_100=100.0

# ===== Log files =====
COMMAND_LOG_FILE=lcs_log.txt
FEEDBACK_LOG_FILE=fcs_log.txt
