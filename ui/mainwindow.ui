 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1280</width><height>820</height></rect></property>
  <property name="windowTitle"><string>LIDAR TRACKER | PAN-TILT CONTROL</string></property>
  <property name="styleSheet"><string notr="true">
QMainWindow, QWidget#centralwidget { background-color:#0E0F11; }
QLabel { color:#D8DCE0; font-size:12px; }
QLabel#titleLabel { color:#7CFC9A; font-size:20px; font-weight:bold; letter-spacing:1px; }
QLabel#subtitleLabel { color:#8A9099; font-size:12px; }
QFrame#header { background-color:#16181B; border:1px solid #242830; border-radius:6px; }
QGroupBox { background-color:#16181B; border:1px solid #242830; border-radius:8px; margin-top:14px; padding:12px 8px 8px 8px; font-weight:bold; color:#7CFC9A; }
QGroupBox::title { subcontrol-origin:margin; left:12px; padding:0 6px; color:#7CFC9A; }
QDoubleSpinBox, QSpinBox { background-color:#0E0F11; color:#E6E9EC; border:1px solid #2E333B; border-radius:4px; padding:3px 6px; min-height:22px; }
QDoubleSpinBox:focus, QSpinBox:focus { border-color:#7CFC9A; }
QRadioButton, QCheckBox { color:#E6E9EC; font-size:12px; spacing:8px; }
QRadioButton:checked { color:#7CFC9A; }
QRadioButton::indicator { width:14px; height:14px; border-radius:8px; border:2px solid #6A707A; background-color:#2A2D33; }
QRadioButton::indicator:hover { border-color:#7CFC9A; }
QRadioButton::indicator:checked { border:2px solid #7CFC9A; background-color:qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #7CFC9A, stop:0.5 #7CFC9A, stop:0.6 #2A2D33, stop:1 #2A2D33); }
QToolButton { background-color:#2A2D33; color:#E6E9EC; border:1px solid #3A3F47; border-radius:6px; font-size:18px; }
QToolButton:hover { border-color:#7CFC9A; }
QToolButton:pressed { background-color:#7CFC9A; color:#0E0F11; }
QToolButton:disabled { color:#5A5F66; }
</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">
    <property name="spacing"><number>10</number></property>
    <property name="leftMargin"><number>12</number></property>
